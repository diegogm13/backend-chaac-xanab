# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT
JWT_SECRET=your_jwt_secret_here
# Expiración de sesión: 2h por defecto (control de seguridad — antes 7d)
JWT_EXPIRES_IN=2h

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:4200
WEBAUTHN_RP_NAME=CHAAC XANAB

# Seed (usuario admin inicial)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your_secure_password_here

# App
PORT=3000

# Channel3 (búsqueda de productos externos/aliados) — https://trychannel3.com
# Crear cuenta gratuita en https://trychannel3.com y copiar la key del dashboard.
# NUNCA exponer esta key en el frontend: solo se usa desde el backend.
CHANNEL3_API_KEY=your_channel3_api_key_here

# Elasticsearch (búsqueda inteligente de productos) — ver docker-compose.elasticsearch.yml
# para levantarlo local con un comando. Sin ELASTICSEARCH_NODE, el buscador sigue
# funcionando (usa el fallback de coincidencia de texto en Supabase) pero sin sinónimos
# ni ranking por marca/género/color.
ELASTICSEARCH_NODE=http://localhost:9200
# Deja vacíos ambos si tu Elasticsearch local no tiene seguridad habilitada.
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# Alternativa a usuario/contraseña (p. ej. Elastic Cloud) — si se define, tiene prioridad.
ELASTICSEARCH_API_KEY=

# Correo (formulario de contacto) — envío vía SMTP de Gmail.
# GMAIL_USER: la cuenta de Gmail de la tienda (ahí llegan los mensajes de /contacto).
# GMAIL_APP_PASSWORD: una "contraseña de aplicación" de Google (no tu contraseña normal),
# se genera en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activada).
# Sin estas dos variables, el formulario de contacto sigue en pie pero no puede enviar correos.
GMAIL_USER=your_gmail_address_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here